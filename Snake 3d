<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Indian Spectacled Cobra — 3D Model</title>
<style>
  *{box-sizing:border-box}
  html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#c9c4ba;font-family:Arial,sans-serif}
  #view{width:100%;height:100%}
  #panel{position:fixed;top:16px;left:16px;padding:12px 15px;border-radius:12px;
    color:#29251f;background:rgba(255,255,255,.72);backdrop-filter:blur(8px);
    box-shadow:0 5px 24px #0002;pointer-events:none}
  #panel strong{display:block;letter-spacing:2px;font-size:14px}
  #panel span{display:block;margin-top:5px;font-size:11px;color:#5e574e}
  #help{position:fixed;bottom:14px;left:0;right:0;text-align:center;
    font-size:11px;color:#514b43;text-shadow:0 1px 2px #fff8;pointer-events:none}
  #error{display:none;position:fixed;inset:auto 12px 45px;padding:12px;background:#fff;
    color:#332;border-radius:8px;font-size:13px}
</style>
<script type="importmap">
{"imports":{
 "three":"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
 "three/addons/":"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
}}
</script>
</head>
<body>
<div id="panel"><strong>INDIAN SPECTACLED COBRA</strong><span>Naja naja · Procedural 3D study</span></div>
<div id="view"></div>
<div id="help">DRAG TO ROTATE · SCROLL TO ZOOM · TWO-FINGER DRAG TO PAN</div>
<div id="error">This 3D model needs an internet connection to load the Three.js library. Open this file in a modern browser.</div>
<script type="module">
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';

const host=document.querySelector('#view');
const scene=new THREE.Scene();
scene.background=new THREE.Color(0xc9c4ba);
scene.fog=new THREE.Fog(0xc9c4ba,13,25);

const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,.1,100);
camera.position.set(6.2,5.0,10.5);

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputColorSpace=THREE.SRGBColorSpace;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.15;
host.appendChild(renderer.domElement);

const controls=new OrbitControls(camera,renderer.domElement);
controls.enableDamping=true;
controls.dampingFactor=.055;
controls.target.set(0,1.85,0);
controls.minDistance=4.5;
controls.maxDistance=17;
controls.maxPolarAngle=Math.PI*.49;

scene.add(new THREE.HemisphereLight(0xfff4df,0x665347,2.0));
const key=new THREE.DirectionalLight(0xffe7c7,3.0);
key.position.set(-4,9,7); key.castShadow=true;
key.shadow.mapSize.set(2048,2048);
key.shadow.camera.left=-7; key.shadow.camera.right=7;
key.shadow.camera.top=7; key.shadow.camera.bottom=-7;
key.shadow.bias=-.00025;
scene.add(key);
const fill=new THREE.DirectionalLight(0xd6e2ff,1.35);
fill.position.set(6,4,-6); scene.add(fill);
const rim=new THREE.PointLight(0xffc98e,22,15);
rim.position.set(0,5,-4); scene.add(rim);

const mat=(color,roughness=.65,metalness=0)=>new THREE.MeshStandardMaterial({color,roughness,metalness});
const bodyMat=mat(0x59412f,.58,.04);
const darkMat=mat(0x261e19,.55);
const bellyMat=mat(0xcbb58e,.78);
const bellyShade=mat(0xa78b63,.8);
const scaleMat=mat(0x806348,.62);
const creamMat=mat(0xe5d4ad,.7);
const markingMat=mat(0x30251e,.7);
const eyeMat=mat(0xb58a43,.3,.12);
const blackMat=mat(0x090807,.18);
const tongueMat=mat(0x9d2630,.45);

const cobra=new THREE.Group(); scene.add(cobra);

function ball(parent,material,position,size,segments=20){
  const mesh=new THREE.Mesh(new THREE.SphereGeometry(1,segments,16),material);
  mesh.position.set(...position); mesh.scale.set(...size);
  mesh.castShadow=true; mesh.receiveShadow=true; parent.add(mesh); return mesh;
}
function tube(parent,points,radius,material,radial=10){
  const curve=new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(...p)));
  const mesh=new THREE.Mesh(new THREE.TubeGeometry(curve,Math.max(40,points.length*12),radius,radial,false),material);
  mesh.castShadow=true; mesh.receiveShadow=true; parent.add(mesh); return mesh;
}

// Broad coiled body, with a tapered tail that continues from the coil.
const coil=[];
for(let i=0;i<=190;i++){
  const t=-.55+(i/190)*Math.PI*2.05;
  const r=1.62;
  coil.push([r*Math.cos(t),.43+.035*Math.sin(t*2),r*.73*Math.sin(t)]);
}
tube(cobra,coil,.39,bodyMat,14);
tube(cobra,[
  [-1.38,.43,-.55],[-1.8,.34,-.9],[-2.05,.25,-1.18],[-2.34,.18,-1.42],[-2.62,.13,-1.58]
],.18,bodyMat,12);

// Subtle belly scutes on the visible front arc of the coil.
for(let i=0;i<42;i++){
  const t=-.15+(i/41)*Math.PI*1.25;
  const r=1.62;
  const p=[r*Math.cos(t),.72,r*.73*Math.sin(t)];
  const plate=ball(cobra,bellyMat,p,[.17,.045,.205],16);
  plate.rotation.y=-t;
}

// Upright neck, gently curved.
tube(cobra,[
  [.05,.48,.05],[.12,.85,.08],[.16,1.28,.1],[.13,1.75,.09],
  [.08,2.18,.07],[.04,2.55,.05],[0,2.83,.04]
],.31,bodyMat,14);

// Front throat strip and transverse belly divisions.
tube(cobra,[
  [.05,.65,.31],[.12,1.05,.34],[.15,1.48,.34],[.12,1.9,.32],[.07,2.3,.29],[.03,2.68,.26]
],.145,bellyMat,12);
for(let i=0;i<12;i++){
  const y=.82+i*.15;
  const f=(y-.65)/2.03;
  const z=.31-.05*f;
  tube(cobra,[[-.105,y,z],[.02,y+.012,z+.018],[.13,y,z]],.012,bellyShade,6);
}

// Hood: a curved, flared panel made from a parametric mesh.
const hood=new THREE.Group(); hood.position.set(0,2.02,.0); cobra.add(hood);
const rows=38,cols=44,verts=[],indices=[];
for(let i=0;i<=rows;i++){
  const v=i/rows;
  for(let j=0;j<=cols;j++){
    const u=j/cols*2-1;
    const width=.25+1.05*Math.pow(Math.sin(v*Math.PI*.92),.8);
    const x=u*width;
    const y=v*1.75;
    const z=-.10-.22*(1-u*u)*Math.sin(v*Math.PI);
    verts.push(x,y,z);
  }
}
for(let i=0;i<rows;i++) for(let j=0;j<cols;j++){
  const a=i*(cols+1)+j,b=a+cols+1;
  indices.push(a,b,a+1,b,b+1,a+1);
}
const hoodGeo=new THREE.BufferGeometry();
hoodGeo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));
hoodGeo.setIndex(indices); hoodGeo.computeVertexNormals();
const hoodMesh=new THREE.Mesh(hoodGeo,new THREE.MeshStandardMaterial({
  color:0x493627,roughness:.67,side:THREE.DoubleSide
}));
hoodMesh.castShadow=true; hoodMesh.receiveShadow=true; hood.add(hoodMesh);

// Hood edges.
for(const s of [-1,1]){
  const edge=[];
  for(let i=0;i<=28;i++){
    const v=i/28,w=.25+1.05*Math.pow(Math.sin(v*Math.PI*.92),.8);
    edge.push([s*w,1.75*v,-.09]);
  }
  tube(hood,edge,.035,darkMat,8);
}

// Spectacle marking: two pale oval loops and a dark central bridge.
for(const s of [-1,1]){
  const x=s*.48,y=1.04;
  const outer=ball(hood,creamMat,[x,y,.015],[.31,.39,.045]);
  outer.rotation.z=s*.18;
  const inner=ball(hood,markingMat,[x,y,.052],[.235,.305,.035]);
  inner.rotation.z=s*.18;
}
tube(hood,[[-.64,1.32,.025],[-.34,1.48,.035],[0,1.34,.05],[.34,1.48,.035],[.64,1.32,.025]],.045,creamMat,8);

// Head, muzzle, jaw and facial markings.
const head=new THREE.Group(); head.position.set(0,2.93,.34); cobra.add(head);
ball(head,bodyMat,[0,.12,.12],[.43,.32,.52],28);
ball(head,bodyMat,[0,-.055,.48],[.34,.19,.35],24);
ball(head,bellyMat,[0,-.19,.46],[.29,.075,.31],20);
ball(head,bodyMat,[0,.015,.72],[.29,.16,.25],24);

for(const s of [-1,1]){
  ball(head,darkMat,[s*.315,.17,.28],[.145,.15,.15]);
  ball(head,eyeMat,[s*.36,.18,.335],[.092,.10,.085]);
  ball(head,blackMat,[s*.385,.18,.397],[.034,.065,.025]);
  ball(head,creamMat,[s*.39,.211,.416],[.014,.018,.012],12);
  ball(head,blackMat,[s*.135,.055,.91],[.027,.022,.018],12);
  // Raised brow ridge.
  tube(head,[[s*.23,.29,.32],[s*.34,.34,.31],[s*.47,.25,.25]],.045,darkMat,8);
  // Small labial scales along the jaw.
  for(let k=0;k<4;k++){
    ball(head,scaleMat,[s*(.12+k*.065),-.075,.68-k*.025],[.045,.025,.055],12);
  }
}

// Mouth seam.
tube(head,[[-.29,-.13,.61],[-.16,-.18,.76],[0,-.19,.79],[.16,-.18,.76],[.29,-.13,.61]],.012,blackMat,6);

// Forked tongue.
const tongue=new THREE.Group(); head.add(tongue);
tube(tongue,[[0,-.08,.91],[0,-.20,1.13],[0,-.25,1.30]],.018,tongueMat,7);
tube(tongue,[[0,-.25,1.27],[-.07,-.29,1.39],[-.13,-.30,1.49]],.009,tongueMat,6);
tube(tongue,[[0,-.25,1.27],[.07,-.29,1.39],[.13,-.30,1.49]],.009,tongueMat,6);

// Fine scale pattern on the hood, arranged in rows.
for(let row=0;row<13;row++){
  const v=.10+row*.064;
  const width=.25+1.05*Math.pow(Math.sin(v*Math.PI*.92),.8);
  const count=Math.max(3,Math.floor(width*11));
  for(let j=0;j<count;j++){
    const u=(j/(count-1))*1.7-.85;
    const x=u*width,y=v*1.75,z=-.10-.22*(1-u*u)*Math.sin(v*Math.PI);
    ball(hood,(row+j)%5===0?scaleMat:darkMat,[x,y,z+.018],
      [.026,.019,.012],10);
  }
}

// A few dorsal scale rows on the visible coil.
for(let i=0;i<90;i++){
  const t=(i/90)*Math.PI*2;
  const r=1.62;
  const x=r*Math.cos(t),z=r*.73*Math.sin(t);
  ball(cobra,i%4===0?scaleMat:darkMat,[x,.78,z],[.045,.025,.055],10);
}

// Ground and soft shadow.
const floor=new THREE.Mesh(new THREE.PlaneGeometry(200,200),
  new THREE.MeshStandardMaterial({color:0xc9c4ba,roughness:.95}));
floor.rotation.x=-Math.PI/2; floor.position.y=.015;
floor.receiveShadow=true; scene.add(floor);

// Soft shadow-catching area beneath the cobra.
const shadow=new THREE.Mesh(new THREE.CircleGeometry(2.7,64),
  new THREE.MeshBasicMaterial({color:0x625b51,transparent:true,opacity:.12}));
shadow.rotation.x=-Math.PI/2; shadow.position.y=.025; shadow.scale.set(1,.62,1);
scene.add(shadow);

const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  const t=clock.getElapsedTime();
  head.rotation.y=Math.sin(t*.65)*.035;
  head.rotation.x=Math.sin(t*.8)*.012;
  hood.rotation.z=Math.sin(t*.55)*.012;
  cobra.position.y=Math.sin(t*1.15)*.018;
  tongue.visible=(Math.sin(t*1.1)>0.93);
  controls.update();
  renderer.render(scene,camera);
}
animate();

addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
